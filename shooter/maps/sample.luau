-- Маленькая тестовая арена: образец того, как описывать карту через kit.
-- Проверка и картинки: lune run shooter-map sample

local kit = require("./kit")

local m = kit.map("Sample", "Образец")

-- Земля: нижний двор, верхняя площадка на высоте 6 и пандус между ними
m:ground(-40, -30, 40, 30, 0)
m:ground(-40, -30, -12, -6, 6, "site")
m:ramp(-12, -22, 0, -14, 0, 6, "-x")

-- Мостик над двором: под ним проход, наверх ведёт пандус с площадки
m:platform(-40, -6, -30, 20, 6, 1)
m:box(-40, 20, -30, 30, 0, 6, "wall2")

-- Туннель с потолком
m:wall(10, -10, 12, 10, 0, 8)
m:wall(24, -10, 26, 10, 0, 8)
m:platform(10, -10, 26, 10, 9, 1, "roof")

-- Внешние стены
m:wall(-42, -32, 42, -30, 0, 20)
m:wall(-42, 30, 42, 32, 0, 20)
m:wall(-42, -32, -40, 32, 0, 20)
m:wall(40, -32, 42, 32, 0, 20)

-- Укрытия
m:crate(0, 10, 4, 4, 4, 0)
m:crate(18, 20, 6, 4, 5, 0, "crate2")
m:crate(-20, -18, 4, 4, 3, 6)

for i = 0, 4 do
	m:spawn("T", -36 + i * 4, 26, 0, 0)
	m:spawn("CT", 28 + i * 2, -26, 0, 180)
end

m:mark("TSpawn", -28, 26, 0)
m:mark("CTSpawn", 32, -26, 0)
m:mark("ASite", -26, -18, 6)
m:mark("BSite", 18, 0, 0)
m:mark("Mid", 0, 0, 0)
m:mark("Bridge", -34, 10, 6)

m:view("from T spawn", -30, 5, 26, 0, 3, 0)
m:view("under the bridge", -20, 4, 8, -40, 3, 8)
m:overview(30, 40, 50, 0, 0, 0)

return m
